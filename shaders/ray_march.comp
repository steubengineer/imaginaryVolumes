#version 450
// Direct-volume ray-marcher (M4: ADR-0011 compute substrate, ADR-0012 camera/
// compositing, ADR-0013 opacity, ADR-0014 colormap). One invocation per pixel.

layout(local_size_x = 8, local_size_y = 8) in;

// Volume: 3D RG32F storing the raw complex value, R = Re(z), G = Im(z) (ADR-0015).
// Magnitude/phase are derived below from the interpolated value, so linear
// filtering stays correct across the phase wrap (a stored angle could not).
layout(set = 0, binding = 0) uniform sampler3D uVolume;
// Output: 2D RGBA8 storage image (ADR-0011).
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D uOutput;
// Cyclic phase colormap LUTs: 1D RGBA8 array, one layer per map, linear + repeat (ADR-0014/0036).
layout(set = 0, binding = 3) uniform sampler1DArray uColormap;

layout(set = 0, binding = 2, std140) uniform Params {
    vec4 eye;         // xyz = camera eye
    vec4 topLeft;     // xyz = top-left ray direction (unnormalized)
    vec4 horizontal;  // xyz = viewport horizontal span
    vec4 vertical;    // xyz = viewport vertical span
    vec4 background;   // rgba background (ADR-0012)
    vec4 range;        // x=minPositive, y=max, z=densityScale, w=alphaTermination
    uvec4 ints;        // x=width, y=height, z=stepCount, w=opacityMode(0 lin,1 log)
    uvec4 modes;       // x=colormapMode (0 twilight,1 HSV,2 infinity,3 grayscale); y=logDecades bits
} P;

const float PI = 3.14159265358979323846;

// ADR-0020: opacity is corrected for the ray step spacing dt so the displayed
// density is invariant to stepCount (and scales with path length). Opacities are
// authored for a reference spacing dt_ref = 1 / kReferenceSteps; the corrected
// per-sample alpha is 1 - (1 - a)^(dt / dt_ref) = 1 - (1 - a)^(dt * kReferenceSteps).
const float kReferenceSteps = 256.0;

// ADR-0013: magnitude -> per-sample opacity. log(0) is never evaluated (the
// m>minPositive guard precedes log); degenerate ranges -> 0 (fully transparent).
float sampleOpacity(float m) {
    float minP = P.range.x;
    float maxM = P.range.y;
    float density = P.range.z;
    float mn = 0.0;
    if (P.ints.w == 0u) {                 // linear
        if (maxM > 0.0) {
            mn = clamp(m / maxM, 0.0, 1.0);
        }
    } else {                              // logarithmic (ADR-0013/0027)
        float decades = uintBitsToFloat(P.modes.y);
        if (decades > 0.0) {              // ADR-0027: window the top `decades` below max
            if (m > 0.0 && maxM > 0.0) {  // mn = 1 + log10(m/max)/decades
                mn = clamp(1.0 + (log(m) - log(maxM)) / (decades * 2.302585093), 0.0, 1.0);
            }
        } else if (m > minP && maxM > minP) { // ADR-0013: full [minPositive, max] range
            mn = clamp((log(m) - log(minP)) / (log(maxM) - log(minP)), 0.0, 1.0);
        }
    }
    return clamp(mn * density, 0.0, 1.0);
}

// Standard hue->rgb for HSV(h,1,1), h in [0,1].
vec3 hsv2rgb(float h) {
    vec3 p = abs(fract(h + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return clamp(p - 1.0, 0.0, 1.0);
}

// ADR-0036: colormapMode -> LUT array layer. 0->0 twilight, 2->1 infinity, 3->2 grayscale
// (mode 1 = analytic HSV has no layer; the caller handles it). Mirrors iv::phaseColor (host).
float colormapLayer(uint mode) {
    return float(mode == 0u ? 0u : mode - 1u);
}

// ADR-0014/0036: phase -> rgb. t = (theta+pi)/2pi, cyclic.
vec3 sampleColor(float phase) {
    float t = (phase + PI) / (2.0 * PI);
    if (P.modes.x == 1u) {                // HSV hue wheel
        return hsv2rgb(t);
    }
    // Cyclic LUT layer (linear + repeat on t; the layer index is integral).
    return texture(uColormap, vec2(t, colormapLayer(P.modes.x))).rgb;
}

void main() {
    uint W = P.ints.x;
    uint H = P.ints.y;
    uvec2 pix = gl_GlobalInvocationID.xy;
    if (pix.x >= W || pix.y >= H) {
        return;
    }

    // Ray generation (ADR-0012): top-left origin, t increases downward.
    float s = (float(pix.x) + 0.5) / float(W);
    float t = (float(pix.y) + 0.5) / float(H);
    vec3 origin = P.eye.xyz;
    vec3 dir = normalize(P.topLeft.xyz + s * P.horizontal.xyz - t * P.vertical.xyz);

    // Ray vs unit cube [0,1]^3 (slab method).
    vec3 invD = 1.0 / dir;
    vec3 ta = (vec3(0.0) - origin) * invD;
    vec3 tb = (vec3(1.0) - origin) * invD;
    vec3 tlo = min(ta, tb);
    vec3 thi = max(ta, tb);
    float t0 = max(max(tlo.x, tlo.y), tlo.z);
    float t1 = min(min(thi.x, thi.y), thi.z);
    float enter = max(t0, 0.0);

    vec3 C = vec3(0.0);
    float A = 0.0;
    if (t1 >= enter) {
        uint N = max(P.ints.z, 1u);
        float dt = (t1 - enter) / float(N);
        for (uint i = 0u; i < N; ++i) {
            float tt = enter + (float(i) + 0.5) * dt;   // segment midpoint
            vec3 p = origin + tt * dir;                 // world == texcoord [0,1]^3
            vec2 zc = texture(uVolume, p).rg;           // (Re, Im); interpolation is valid here
            float a = sampleOpacity(length(zc));        // magnitude = |z| (ADR-0013)
            a = 1.0 - pow(max(1.0 - a, 0.0), dt * kReferenceSteps); // dt-correct (ADR-0020)
            vec3 col = sampleColor(atan(zc.y, zc.x));   // phase = atan2(Im, Re) in [-pi, pi]
            C += (1.0 - A) * a * col;                   // front-to-back over
            A += (1.0 - A) * a;
            if (A >= P.range.w) {                        // early-ray termination
                break;
            }
        }
    }

    vec3 outRgb = C + (1.0 - A) * P.background.rgb;      // composite over background
    imageStore(uOutput, ivec2(pix), vec4(outRgb, 1.0));
}
